Items: {
	ChestWand: {
		DisplayName: 宝箱の杖
		Tooltip:
			'''
			使い方:
			- 右クリックで宝箱のルールメニューを開く
			- 宝箱生成のルールを設定するには、宝箱のルールメニューを使う
			- 宝箱を左クリックで現在のルールを設定する

			別の使い方:
			- ルールが設定されている宝箱を右クリックすると、ルールをコピーできる
			'''
	}

	MultistructureWand: {
		DisplayName: マルチ建築の杖
		Tooltip:
			'''
			使い方:
			- 構造物の角を左クリック2回で選択する
			- 次に右クリックして、選択した構造物を現在のマルチ建築物に追加する
			- 必要な建築物全てに対してこの手順を繰り返す
			- 完了したら、インベントリ内で右クリックでマルチ建築物を保存する
			'''
	}

	StructureWand: {
		DisplayName: 建築の杖
		Tooltip:
			'''
			使い方:
			- 構造物の角を左クリック2回で選択する
			- その後に右クリックで構造物を保存する
			'''
	}

	TestWand: {
		DisplayName: 構造物配置ワンド
		Tooltip:
			'''
			使い方:
			- 右クリックで構造物セレクターを開く
			- 左クリックで選択した構造物を配置
			'''
	}

	NullBlockItem: {
		DisplayName: 通過ブロック
		Tooltip:
			'''
			これらを構造物内で使用して、ジェネレーターの位置を示す
			ワールド内に既に存在するものは、そのままにしておくべきだ
			(壁は無視する。この場合、通過壁を使おう)
			'''
	}

	NullTileAndWallPlacer: {
		DisplayName: 追加ブロック・壁配置ツール
		Tooltip: 通過ブロックと通過壁を同時に配置する
	}

	NullWallItem: {
		DisplayName: 通過壁
		Tooltip:
			'''
			これらを構造物内で使用して、ジェネレーターの位置を示す
			ワールド内に既に存在するものは、そのままにしておくべきだ
			(壁のみに適応される。他のブロックは通過ブロックを使おう)
			'''
	}

	PortingWand: {
		DisplayName: 移植の杖
		Tooltip:
			'''
			使い方:
			- ver3.0以前の全ての構造物をSavedStructuresディレクトリに配置すること
			- ゲーム内でアイテムを使用すると、SavedStructuresディレクトリ内の全ての構造物が自動的に転送される
			- 従来の構造物ファイルを新しい「.shstruct」および「.shmstruct」ファイルに置き換えること
			'''
	}

	CustomDataWand: {
		DisplayName: カスタムデータの杖
		Tooltip:
			'''
			高度なツールで、登録後に構造物を保存するためのカスタムブロックデータのオン/オフを切り替えることができる
			詳細についてはドキュメントを参照すること（https://github.com/ScalarVector1/StructureHelper/wiki/Saving-Custom-Data）
			'''
	}
}
