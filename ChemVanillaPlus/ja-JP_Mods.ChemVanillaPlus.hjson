			Other: その他の微調整
		}

		BaitConversion: {
			Label: 釣り餌の変換レシピ
			Tooltip:
				'''
				見習いの餌5個を仕事人の餌1個に、
				仕事人の餌5個を玄人の餌1個に合成できるようになります(逆の変換も可能)。
				効率が必ず良くなるわけではありませんが、玄人の餌を集めやすくなります。
				'''
		}

		TaoShardConversion: {
			Label: 陰陽の欠片のシマー変換レシピ
			Tooltip: 光の欠片をシマーに落とすことで闇の欠片に変換できるようになります(逆も同様)。
		}

		PurificationPowder: {
			Label: 浄化の粉のレシピ
			Tooltip: キノコとデイブルームを使って、瓶詰めの水(または調合瓶)で浄化の粉をクラフトできるようになります(というかマジで、なぜバニラにこれが無いんだ？)
		}

		BeeStingers: {
			Label: ハチが毒針をドロップ
			Tooltip: 文字通りの機能です。女王蜂にも影響します。
		}

		WallHellstone: {
			Label: ウォールオブフレッシュがヘルストーンをドロップ
			Tooltip: 文字通りの機能です。
		}

		PlanteraChlorophyte: {
			Label: プランテラがクロロファイト鉱石をドロップ
			Tooltip: 文字通りの機能です。
		}

		EoCLenses: {
			Label: クトゥルフの目がレンズをドロップ
			Tooltip: 文字通りの機能です。
		}

		CalmDownTurtles: {
			Label: おとなしくなったカメ
			Tooltip: ジャングル地表でのジャイアントタートルのスポンを阻止し、時間帯に応じてダープリングまたはジャイアントフライングフォックスに置き換えます。
		}
