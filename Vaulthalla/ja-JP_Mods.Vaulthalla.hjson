Element: {
	Kinetic: キネティック
	Incendiary: ファイアー
	Shock: ショック
	Corrosive: コロッシブ
	Cryogenic: クリオ
	Radioactive: レディエーション
	Slag: スラグ
	Explosive: エクスプローシブ
	Universal: アダプティブ
}

ElementDebuffInfo: {
	HoldShift: "[c/808080:[LSHIFT]] [c/808080:長押しでエレメンタルを表示]"
	Incendiary:
		'''
		中程度の持続ダメージ
		冷系に強く、熱系に弱い
		'''
	Shock:
		'''
		高い持続ダメージを与え、敵の接触ダメージを25%減少させる
		水棲/スライムに強く、植物/虫に弱い
		'''
	Corrosive:
		'''
		中程度の持続ダメージを与え、敵の防御力を25%減少させる
		装甲系に強く、水棲/スライムに弱い
		'''
	Cryogenic:
		'''
		中程度の持続ダメージ
		熱系に強く、冷系に弱い
		'''
	Radioactive:
		'''
		低い持続ダメージ、敵の死亡時に放射能の雲を撒き散らす爆発を起こす
		植物/虫に強く、装甲系に弱い
		'''
	Slag:
		'''
		命中時に5秒間、対象をスラグ状態にする
		スラグ状態の対象は、ダメージを伴うデバフを含む、スラグ以外のあらゆる発生源から50%多くのダメージを受ける
		真の近接攻撃が命中した場合、このボーナスは2倍になる
		'''
	Kinetic:
		'''
		特殊な特性はないが、この属性を持つほとんどの銃はあらゆる種類の弾薬を使用できる
		すべての敵に対して等倍
		'''
	Explosive:
		'''
		着弾時に爆発を起こし、周囲の敵に範囲ダメージを与える
		基本的にはすべての敵に対して等倍だが、銃の第二属性によって例外が存在する場合がある
		'''
	Universal:
		'''
		対象に属性の弱点がある場合、最も高いボーナスダメージを与えられる属性に変化する
		さらに命中した対象を5秒間スラグ状態にし、着弾時にスラグ爆発を引き起こす
		スラグ状態の対象は、ダメージを伴うデバフを含む、スラグ以外のあらゆる発生源から50%多くのダメージを受ける
		真の近接攻撃が命中した場合、このボーナスは2倍になる
		'''
}

Special: {
	Burst: "{0}点バースト"
