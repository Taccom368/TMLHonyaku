Configs: {
	VaulthallaClientConfig: {
		DisplayName: クライアント

		ShowElementalDebuffInfo: {
			Label: エレメンタルを表示
			Tooltip: LSHIFTキーを長押ししている間、エレメンタルを説明するツールチップを追加で表示します
		}

		FataleRealName: {
			Label: Fataleの旧名
			Tooltip: 保護者への勧告(下品な表現が含まれます)
		}

		KP1216: {
			Label: KP-1216 著作権対策
			Tooltip:
				'''
				KP-1216の発射音を、耳に優しいかもしれない音に変更します
				"「Bane(ベイン)はどうなんだ」"って？まさか、ハハハ
				'''
		}

		AutoreuseNotif: {
			Label: ツールチップにオート再使用を表示
			Tooltip:
				'''
				銃がオート再使用可能かどうかをツールチップに表示させます
				Semi-Auto = オート再使用不可
				Full-Auto = オート再使用可能
				これはこのMODで追加された銃にのみ影響します
				主にデバッグ用に用意されたものですが、一般のプレイヤーにとっても便利で雰囲気が出るかもしれません
				'''
		}

		EoLInvincibleName: {
			Label: 昼のEoLの特殊名
			Tooltip:
				'''
				昼間にエンプレス・オブ・ライトと戦う際、名前に「Invincible(無敵の)」の肩書を付与します
				EoLの名前を変更するリソースパックを使用している場合、見た目が奇妙になる可能性があります
				'''
		}
	}

	VaulthallaServerConfig: {
		DisplayName: サーバー

		TVHM: {
			Label: True Vault Hunter Mode
			Tooltip:
				'''
				Borderlandsスタイルのハクスラ体験に合わせ、ドロップ率を低下させます
				新しいコンテンツにすぐにアクセスしたい場合は無効にしてください。責めたりしませんので...
				'''
		}
	}
}

