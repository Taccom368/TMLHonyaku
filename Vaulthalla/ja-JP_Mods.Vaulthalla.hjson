RedText: {
	EridiumAmulet: "[c/FF3232:エントロピー？ 灰色さ。持ち物には気をつけな。]"
	BasicRepeater:
		'''
		[c/FF3232:のちに、君が稲妻を放つ銃で摩天楼サイズの大怪獣を仕留めるようになったとき、]
		[c/FF3232:この瞬間を振り返って『ふっ』って笑うことになるのさ。]
		'''
	GwensHead: "[c/FF3232:箱の外で考える。]"
	CloudKill: "[c/FF3232:さあ、立ち上がれ。]"
	TheCure: "[c/FF3232:予防接種は命を救う。ごめん、ジョークはない！ あるのは事実だけ。]"
	ASMD: "[c/FF3232:追跡調査でもやるつもりか？]"
	Hellwalker: "[c/FF3232:悪魔ども、覚悟しな。]"
	Shredifier: "[c/FF3232:スピードは命取り。]"
	NightFlyer: "[c/FF3232:俺には1つの掟がある。]"
	Florentine: "[c/FF3232:ダブルトラブル。]"
	Bane: "[c/FF3232:人を壊す、災の元。]"
	TidalWave: "[c/FF3232:波から逃げろ！]"
	TKsWave: "[c/FF3232:波に乗れ、ブラザー！]"
	Cobra: "[c/FF3232:気付いた時にはえーーーって感じ。あの銃を取り戻すんだから！]"
	Flakker: "[c/FF3232:フラック・ザ・ワールド！]"
	UnkemptHarold:
		'''
		[c/FF3232:6発いや5発しか撃ってないか？]
		[c/FF3232:それとも3発？7発？なんだっていいさ。]
		'''
	UnkemptHaroldDP: "[c/FF3232:俺も数えてなかったよ。]"
	Maggie: "[c/FF3232:なめてかかると、痛い目見るぜ。]"
	Fatale: "[c/FF3232:そう。戻ってきたぞ。]"
	Sloth: "[c/FF3232:酔ったてん末...]"
	HellFire: "[c/FF3232:水なんていらねぇ...]"
	BoneShredder: "[c/FF3232:鉛の風が吹く！]"
	Nukem: "[c/FF3232:某有名人の名で箔をつけた一品。]"
	Moonfire: "[c/FF3232:己の運命に出会え。]"
	Ogre: "[c/FF3232:Orcとの違いは、食べ物を噛むかどうか。]"
	Hail: "[c/FF3232:今日はどんな遊びを教えてくれるんだい？]"
	GrogNozzle: "[c/FF3232:車はダメよ...]"
	Chimera: "[c/FF3232:多くの姿を持つ獣 －炎、雷、精度、そして毒。]"
	Hydra: "[c/FF3232:5つの銃口が火を吹くぜ！]"
	TheButcher: "[c/FF3232:アァァァ... 新鮮な肉だ！]"
	NullPointer: "[c/FF3232:(゜∀。)＜ ぬるぽ]"
	Pyrophobia: "[c/FF3232:実際のところ、恐れるほうが正しい。]"
	CalypsoCall: "[c/FF3232:私たちの人生は私たちのもの。 好きに生きる。]"
	Badaboom: "[c/FF3232:マルチキル。]"
	Storm: "[c/FF3232:おや、雨が降るようだ。]"
	Firestorm: "[c/FF3232:ただちに避難せよ。]"
	Lyuda: "[c/FF3232:男殺し。]"
	Hornet: "[c/FF3232:恐怖の群れ]"
	Scorpio: "[c/FF3232:わずかなお金で毎日できる移動式弾圧。]"
	LongMusket: "[c/FF3232:「暗号資産」って言ってみろ！]"
	Gunerang: "[c/FF3232:試しに投げてみな。]"
	Deliverance: "[c/FF3232:キキがショットガンを手に入れた。]"
	Fibber: "[c/FF3232:私があなたに嘘をつくと思う？]"
	DoubleAnarchyTediore: "[c/FF3232:弾丸ホースが火を噴くぜ。]"
	DoubleAnarchyTorgue: "[c/FF3232:何かを補っているに違いない...]"
	DoubleAnarchyDahl: "[c/FF3232:千回斬りによる死。]"
	DoubleAnarchyGearbox: "[c/FF3232:だが、なぜこんなことを？]"
	BadTouch: "[c/FF3232:私がいい子にしてるときは、最高に気持ちいいわよ...]"
	PlasmaCoil: "[c/FF3232:物質の第4状態を利用せよ。]"
	Norfleet: "[c/DC7800:なんでも吹き飛ばす！]"

	Effervescent: {
		AdvancedRepeater: "[c/FF3232:調子はどうだい？]"
		Fumigator: "[c/FF3232:奴らに悪臭をくれてやれ。]"
		DemonCore: "[c/FF3232:狂気を具現化する時間だ。]"
		KP1216: "[c/FF3232:レーザーで奴らを破壊しろ！]"
		Adrasteia: "[c/FF3232:またたく間に。]"
		TheCatalyst: "[c/FF3232:癒やすことは、痛めつけることほど報われない。]"
		SuperShredifier: "[c/FF3232:これぞまさに対空砲だ。]"
		Red9: "[c/FF3232:どう思う、レオン？ 人は変われるよな？]"
		Ultima: "[c/FF3232:さりげなくぶっ壊れ。]"
		Migraine: "[c/FF3232:奴らは明日の朝、それを痛感することになるだろう。]"
		MigraineDP: "[c/FF3232:ぶっ飛んだな。]"
		Bomber: "[c/FF3232:これが欲しいのか？くれてやるよ、友よ！]"
		Marigold: "[c/FF3232:大器晩成。]"
		Hermes: "[c/FF3232:使者を撃つな。]"
		BoneSaviour: "[c/FF3232:鉛の雨だ、ハレルヤ！]"
		OneLiner: "[c/FF3232:お前に聖なる体を与えてやろう！]"
		Toll: "[c/FF3232:この世にタダのものは何もない。]"
		Hinotama: "[c/FF3232:人生という名の家を焼き尽くせ！]"
		DeathPenalty: "[c/FF3232:悪夢が始まる。]"
		Bermuda: "[c/FF3232:深淵へ沈め！]"
		Rebellion: "[c/FF3232:悪魔も泣き出すかもな。]"
		PeaceWalker: "[c/FF3232:あいつら俺たちをバイオリンみたいに操りやがった！]"
		PhantomPain: "[c/FF3232:待たせたな。]"
		Ersatz: "[c/FF3232:本物さ。(いや、違うけど。)]"
		Crackshot: "[c/FF3232:1+1=3]"
		MeteorStrike: "[c/FF3232:大嵐よ来たれ、我に仇なす者をすべて滅ぼせ！]"
		Hecate: "[c/FF3232:これは私の戦いだ、他の誰のものでもない。]"
		Sabre: "[c/FF3232:お前ら、うちの奥さんに会ったか？]"
		CausticScorcher: "[c/FF3232:ただ世界が燃えるのを見たいだけの人間もいる。]"
		SunderedTwilight:
			'''
			[c/FF3232:いつの日か君を解放し、この腕に抱きしめよう。]
			[c/FF3232:なぜなら、君の平穏こそが私の願いだからだ。]
			'''
	}
}

Items: {
	RubberBullet: {
		DisplayName: ジェリド弾
		Tooltip:
			'''
			至近距離で乗算25%のボーナスダメージを与える
			液体に接触すると消滅する
			'''
	}

	SlagBullet: {
		DisplayName: スラグボール
		Tooltip:
			'''
			武器ダメージが33%減少するが、対象を長時間スラグ状態にする
			スラグ状態の対象は、ダメージを伴うデバフを含む、スラグ以外のあらゆる発生源から50%多くのダメージを受ける
			真の近接攻撃が命中した場合、このボーナスは2倍になる
			'''
	}

	SlagBulletSuperior: {
		DisplayName: スラグチップ弾
		Tooltip:
			'''
			短時間対象をスラグ状態にする
			まだスラグ状態になっていない対象に対して、より高いダメージを与える
			スラグ状態の対象は、ダメージを伴うデバフを含む、スラグ以外のあらゆる発生源から50%多くのダメージを受ける
			真の近接攻撃が命中した場合、このボーナスは2倍になる
			'''
	}

