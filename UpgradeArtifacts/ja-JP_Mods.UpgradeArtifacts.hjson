Items: {
	JungleMask: {
		DisplayName: ジャングルの仮面
		Tooltip:
			'''
			召喚ダメージが8%増加
			ミニオンが敵に毒を与えることがある
			'''
	}

	PreciousBelt: {
		DisplayName: 尊いベルト
		Tooltip:
			'''
			召喚できるミニオンの数が1体増え、
			召喚しているミニオン1体ごとに防御力が1増加
			'''
	}

	PredatorOfTheJungle: {
		DisplayName: ジャングルの捕食者
		Tooltip:
			'''
			召喚できるミニオンの数が1体増え、
			召喚しているミニオン1体ごとに召喚ダメージが3%増加
			ミニオンが敵に毒を与える
			ダメージを受けると蜂を放って、使用者を蜂蜜に浸す
			'''
	}

	HeavenlyShield: {
		DisplayName: 神聖な砦
		Tooltip:
			'''
			8防御力
			ダメージの一部を反射する
			ライフが35%以下の際、被ダメージを12%軽減
			全ステータスを少し強化
			水、溶岩、蜂蜜内で素早く動ける
			ほとんどの状態異常に対する耐性
			身につけると光を放つ
			'''
	}

	ObsidianFireBowl: {
		DisplayName: 黒曜石のボウル
		Tooltip:
			'''
			鞭の攻撃速度が10%上昇し、鞭で攻撃した敵を炎上させることがある
			炎上を無効化する！
			ライフが50%以下の際、獄炎を得る
			'''
	}

	SpiderSwarmNecklace: {
		DisplayName: クモの群れのアミュレット
		Tooltip:
			'''
			召喚ダメージが45%減少するが、
			召喚できるミニオンの数が2倍になり、
			ミニオンが敵に毒を与えることがある
			'''
	}

	RegularClover: {
		DisplayName: 普通のクローバー
		Tooltip: ゴルフでは運は当てにならない...
	}

	RoyalAmulet: {
		DisplayName: 高貴なアミュレット
		Tooltip:
			'''
			移動速度が15%上昇
			アイテムを拾う距離が広がる 
			スライム系から攻撃を受けない
			体が光る
			採掘した鉱石を2倍入手できるようになる
			エキスパート
			'''
	}

	GripOfTheCursedFlame: {
		DisplayName: 呪いの炎の籠手
		Tooltip:
			'''
			鞭のダメージが12%増加
			鞭のノックバックが増加
			鞭で攻撃した敵を呪いの炎で燃やすことがある
			鞭で一度に攻撃した敵1体ごとに鞭の攻撃速度が8%上昇し、
			最大で40%上昇する
			'''
	}

	TalismanOfResonance: {
		DisplayName: 共鳴のタリスマン
		Tooltip:
			'''
			近接攻撃速度が4%上昇
			近接武器で3回攻撃するごとに魔法弾を放つ
			'''
	}

	TowerShieldOfTerror: {
		DisplayName: 恐怖のタワーシールド
		Tooltip:
			'''
			4防御力
			45近接ダメージ
			ノックバック: とても強い
			被ダメージを8%軽減
			被ダメージの一部をライフに変換することがある
			敵に向かってダッシュ攻撃でき、敵を貫通する
			エキスパート
			'''
	}

	ObsidianBracer: {
		DisplayName: 黒曜石の腕当て
		Tooltip:
			'''
			2防御力
			近接攻撃のノックバックを増加
			近接武器で攻撃すると黒曜石の鎧を3秒間得て、防御力が5増加する
			'''
	}

	AmuletOfMalice: {
		DisplayName: 地獄のタリスマン
		Tooltip:
			'''
			近接ダメージが6%増加し、近接攻撃速度が6%上昇
			近接武器で攻撃すると幽霊を放つ
			'''
	}

	EmptyRing: {
		DisplayName: 空の指輪
		Tooltip: 1防御力
	}

	InfinityRing: {
		DisplayName: インフィニティリング
		Tooltip:
			'''
			最大ライフとマナが40増加し、ライフとマナの自然回復を増進
			ダメージが10%増加し、クリティカル率と攻撃速度が10%上昇
			敵の防御力を6無視し、被ダメージを6%軽減
			移動速度が上昇し、ジャンプ速度が増加
			飛行時間を延長し、最大落下速度と採掘スピードが上昇
			身につけると虹色の光を放つ
			ライフが20%以下になるとライフが120回復し、4秒間無敵になる
			クールダウンは5分
			「1つの指輪に無限の力が宿っている」
			'''
	}

	StellarMarble: {
		DisplayName: 星の大理石
		Tooltip:
			'''
			近接クリティカル率が6%上昇
			近接攻撃でクリティカル時に星が落ちてくる
			'''
	}

	LivingGranite: {
		DisplayName: 御影石のハート
		Tooltip:
			'''
			4防御力
			近接ダメージが8%増加し、近接攻撃速度が8%上昇
			近接武器で敵を攻撃すると火花を放つことがある
			'''
	}

	Mirror: {
		DisplayName: 鏡
		Tooltip: ""
	}

	DistortedMirror: {
		DisplayName: 歪んだ鏡
		Tooltip:
			'''
			クリティカル率が5%上昇
			魔法武器で攻撃時に50%の確率で弾を追加で発射するが、
			マナ消費量が35%増加
			'''
	}

	BlindEye: {
		DisplayName: 盲目の目
		Tooltip:
			'''
			魔法攻撃速度が10%上昇するが
			魔法武器の弾が拡散しやすくなる
			'''
	}

	AllSeeingEye: {
		DisplayName: 全知の目
		Tooltip:
			'''
			マナ消費量が10%減少
			魔法攻撃速度が15%上昇するが、
			魔法武器の弾が拡散しやすくなる
			マナスターを拾う距離が広がる
			マナポーションを自動で使用してくれる
			'''
	}

	SignOfSpace: {
		DisplayName: 天空の印
		Tooltip:
			'''
			魔法クリティカル率が8%上昇
			魔法武器でクリティカル時にたくさんのハーピーの羽で追撃する
			'''
	}

	FossilizedBone: {
		DisplayName: 化石の骨
		Tooltip:
			'''
			魔法ダメージが15%減少するが、
			魔法攻撃速度が12%上昇し、
			魔法武器の弾の敵の貫通数が1体増える
			'''
	}

	ManaShield: {
		DisplayName: マナアブソーバー
		Tooltip:
			'''
			最大マナが50増加
			被ダメージの25%をマナで吸収するが、
			マナポーションとマナスターでマナを回復できなくなる
			攻撃を受けるとマナが8秒間回復しなくなる
			マナが0になると防具破損を受け、マナによるダメージ吸収が30秒間なくなる
			ダメージを吸収しなくなっている間、マナ自然回復を増進する
			'''
	}

	SilverFeather: {
		DisplayName: 銀の羽根
		Tooltip:
			'''
			遠距離クリティカル率が8%上昇
			遠距離武器でクリティカル時に喀血を与える
			'''
	}

	HunterSign: {
		DisplayName: 狩人の印
		Tooltip:
			'''
			遠距離攻撃速度が8%上昇
			遠距離クリティカル率が6%上昇
			遠距離武器で敵を攻撃すると毒を与えることがある
			'''
	}

	RangerBadge: {
		DisplayName: レンジャーのバッジ
		Tooltip:
			'''
			遠距離攻撃速度が6%上昇
			クリティカル率が4%上昇
			'''
	}

	BlastingBandolier: {
		DisplayName: 爆発弾帯
		Tooltip:
			'''
			遠距離ダメージが8%増加
			弾丸が当たると爆発することがある
			12%の確率で弾薬を消費しない
			'''
	}

	SurvivalKit: {
		DisplayName: 弓兵の道具
		Tooltip:
			'''
			矢の速度が上昇
			矢の敵の貫通数が2体増える
			15%の確率で矢を消費しない
			'''
	}

	SkyCrown: {
		DisplayName: 空の王冠
		Tooltip:
			'''
			召喚ダメージが5%増加
			1秒ごとにハーピーの羽根を1枚生成する（最大で4枚まで）
			羽根は近くの敵を攻撃する
			'''
	}

	SeedOfLife: {
		DisplayName: 生命の種
		Tooltip:
			'''
			動かずにいると、ライフ自然回復を増進
			ライフが50%以下の際、ドライアドの祝福を得る
			「ドライアドはこれを大切にしている」
			'''
	}

	FrozenScale: {
		DisplayName: 氷の鱗
		Tooltip:
			'''
			4防御力
			移動速度が10%低下
			被ダメージ時に敵の動きを遅くする鱗の破片を放つ
			'''
	}

	NecklaceOfBones: {
		DisplayName: 骨のネックレス
		Tooltip:
			'''
			お気に入りに登録するとインベントリ内で効果を発揮する
			敵の出現率と出現上限が上昇
			'''
	}

	TideShell: {
		DisplayName: 潮の甲羅
		Tooltip:
			'''
			水中にとても長く居られる
			液体内で被ダメージを15%軽減し、光を放つ
			'''
	}

	AntFangs: {
		DisplayName: 蟻の牙
		Tooltip:
			'''
			近接攻撃速度が33%上昇するが、
			近接ダメージが10%減少し、
			近接武器のサイズが20%減少する
			'''
	}

	SwarmComb: {
		DisplayName: 群れのハニカム
		Tooltip:
			'''
			敵を倒すと蜂をいくつか召喚することがある
			ジャングルにいると蜂蜜を得る
			'''
	}

	MinerLantern: {
		DisplayName: 故障したランタン
		Tooltip:
			'''
			2防御力
			光を発するが、時折ちらつく
			光を発しているときは宝物や鉱石の位置がわかる
			'''
	}

	NectarOfLife: {
		DisplayName: 生命の蜜
		Tooltip:
			'''
			ライフ自然回復を増進し、回復ポーションの再使用間隔を33%短縮させる
			ダメージを受けると蜂を放って、使用者を蜂蜜に浸し、移動速度が上昇する
			回復ポーションを使用するとあなたを回復する蜂を召喚する
			'''
	}

	AuroraVeil: {
		DisplayName: オーロラベール
		Tooltip:
			'''
			6防御力
			ノックバックを無効化し、被ダメージ時の無敵時間を延長する
			ライフが50%以下の際、被ダメージを25%軽減する
			ダメージを受けると敵を追尾する流れ星が降る
			'''
	}

	DollOfSilence: {
		DisplayName: 沈黙の人形
		Tooltip:
			'''
			お気に入りに登録するとインベントリ内で効果を発揮する
			敵の出現率と出現上限が低下
			'''
	}

	CursedFlameQuiver: {
		DisplayName: 呪いの炎の矢筒
		Tooltip:
			'''
			矢のダメージが12%増加し、矢の速度が大幅に上昇
			矢が敵を2体貫通するようになり、当たった敵に呪炎を与える
			33%の確率で矢を消費しない
			'''
	}

	VeteranArcherSign: {
		DisplayName: 熟練弓兵のバックパック
		Tooltip:
			'''
			遠距離ダメージが10%増加
			遠距離クリティカル率が12%上昇
			敵の防御力を5無視する
			遠距離武器でクリティカル時に喀血を与える
			'''
	}

	TopazAmberRing: {
		DisplayName: 探検家の指輪
		Tooltip:
			'''
			2防御力
			移動速度が12%上昇し、採掘スピードが15%上昇
			ジャンプの高度と速度が増加
			光を放つ
			'''
	}

	RubySapphireRing: {
		DisplayName: モンクの指輪
		Tooltip:
			'''
			2防御力
			最大ライフとマナが25増加
			ライフとマナの自然回復を増進
			'''
	}

	EmeraldAmethystRing: {
		DisplayName: 破壊の指輪
		Tooltip:
			'''
			2防御力
			ダメージが5%増加し、クリティカル率が5%上昇
			攻撃速度が6%上昇
			敵の防御力を2無視する
			'''
	}

	GhostlySkull: {
		DisplayName: 幽霊のドクロ
		Tooltip:
			'''
			魔法ダメージが10%減少するが、
			魔法攻撃速度が12%上昇
			魔法武器の弾の敵の貫通数が3体増える
			魔法武器で倒した敵から霊魂がいくつか放たれることがある
			霊魂は敵を追尾し、敵を貫通し、何回かヒットする
			'''
	}

	CursedGauntlet: {
		DisplayName: 呪いの籠手
		Tooltip:
			'''
			近接ダメージが12%増加
			近接攻撃速度が15%上昇
			近接攻撃で攻撃した敵を呪いの炎で燃やすことがあり、
			クリティカル時は霊液を与える
			近接武器のサイズとノックバックが増加
			'''
	}

	TacticalScope: {
		DisplayName: タクティカルスコープ
		Tooltip:
			'''
			遠距離ダメージが10%増加し、遠距離クリティカル率が10%上昇
			銃を装備時、右クリックで視界を広げることができる
			視界を広げているとさらに遠距離ダメージが6%増加し、遠距離クリティカル率が6%上昇し、
			攻撃した敵に破壊を与える
			敵に狙われにくくなる
			20%の確率で弾薬を消費しない
			'''
	}

	EyeOfCorruption: {
		DisplayName: 腐敗の眼
		Tooltip:
			'''
			腐敗のオーラが発生し、その中だと
			自身は被ダメージが10%増加
			敵は被ダメージが15%増加
			悪臭を受けるが、非表示にすると受けない
			「体を洗うのは自分自身への冒涜だ」
			'''
	}

	CactusGuard: {
		DisplayName: サボテンの盾
		Tooltip:
			'''
			2防御力
			被ダメージ時、トゲを放つ
			砂漠にいると防御力が4増加し、移動速度が10%上昇
			'''
	}

	CrimsonHeart: {
		Tooltip:
			'''
			最大ライフが10%減少するが、
			2秒ごとに最大ライフの1%を回復する
			ライフが少ないほど回復量が増加する
			「この心臓の鼓動はいつか止まるのか？」
			'''
		DisplayName: 真紅の心臓
	}

	CelestialBracers: {
		DisplayName: 宇宙の小手
		Tooltip:
			'''
			2防御力
			近接クリティカル率が10%上昇し、近接武器でクリティカル時、
			味方の星を5個まで召喚することがある
			星は4秒間持続し、防御力が2増加
			'''
	}

	TotemOfBlightedLight: {
		DisplayName: 蝕光のトーテム
		Tooltip:
			'''
			最大ライフが5%増加し、1.5秒ごとに最大ライフの1%を回復する
			輝きのオーラが発生し、その中だと
			自身は被ダメージが10%増加
			敵は被ダメージが20%増加し、蝕光を受ける
			動かずにいると回復量が2.5%になる
			エキスパート
			'''
	}

	ThornheartBloom: {
		Tooltip:
			'''
			ライフ自然回復量が2倍になる
			移動速度が15%上昇
			周囲に攻撃性能がある胞子を呼び出す
			被ダメージ時、追加で胞子を呼び出す
			ドライアドの祝福を得る
			エキスパート
			'''
		DisplayName: トゲのハートのブルーム
	}

	SkeletronJaw: {
		Tooltip:
			'''
			攻撃した敵にシャドウフレイムを与えることがある
			4つの骨が周囲を回る
			ごくまれに攻撃のダメージが1になることがある
			'''
		DisplayName: 呪われた顎
	}
}

Projectiles: {
	SpaceFeather.DisplayName: ""
	CelestialSwarmProj.DisplayName: ""
	HealingBee.DisplayName: 癒しの蜂
	CelestialBracersMinion.DisplayName: 小手の星
	ThornheartSpore.DisplayName: トゲのハートの胞子
	ThornheartSporeFlash.DisplayName: トゲのハートの胞子
	SkeletronJawBone.DisplayName: スケルトロンの顎の骨
}

Buffs: {
	BloodlettingDebuff: {
		DisplayName: 喀血
		Description: 大量に出血している
	}

	BreakingDebuff: {
		Description: Mods.UpgradeArtifacts.Buffs.BreakingDebuff.Description
		DisplayName: 破壊
	}

	LightburnDebuff: {
		Description: Mods.UpgradeArtifacts.Buffs.LightburnDebuff.Description
		DisplayName: 蝕光
	}
}
